# =============================================================
# URL Shortener & Analytics — Environment Variables
# Copy this file to .env and fill in values before running.
# =============================================================

# ---- PostgreSQL ----
POSTGRES_USER=shortener
POSTGRES_PASSWORD=changeme
POSTGRES_DB=analytics

# ---- Redis ----
# No password for local practice projects
REDIS_URL=redis://redis:6379/0

# ---- api-service ----
# Base URL used to construct short links returned by the API
BASE_URL=http://localhost:80
# TTL for stored short URLs in seconds (86400 = 24h)
URL_TTL=86400

# ---- worker-service ----
# Full DSN for PostgreSQL
DATABASE_URL=postgresql://shortener:changeme@postgres:5432/analytics
# How many click events to batch-insert in one transaction
BATCH_SIZE=10
# Seconds to wait on BLPOP before looping
POLL_TIMEOUT=5
