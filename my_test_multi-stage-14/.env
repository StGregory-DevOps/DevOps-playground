# ---- MySQL (официальный образ ждёт именно эти имена) ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=pulsecheck
MYSQL_USER=pulsecheck
MYSQL_PASSWORD=pulsecheck

# ---- API + worker (SQLAlchemy) ----
# Значения должны совпадать с MYSQL_* выше — один и тот же пользователь/база,
# просто у каждого сервиса свои ожидаемые имена переменных.
DB_HOST=mysql
DB_PORT=3306
DB_USER=pulsecheck
DB_PASSWORD=pulsecheck
DB_NAME=pulsecheck

CORS_ORIGIN=*

# ---- worker ----
TICK_SECONDS=5
REQUEST_TIMEOUT_SECONDS=5
